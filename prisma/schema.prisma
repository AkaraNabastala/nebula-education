// Prisma Schema — Sistem Informasi Manajemen Sekolah Terintegrasi (SIM Sekolah Edutera)
// Database: PostgreSQL
// Framework Backend Target: NestJS + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. IDENTITAS AKUN & SISTEM HAK AKSES (RBAC)
// ==========================================

enum UserCategory {
  ADMIN_APLIKASI
  GURU
  SISWA
  STAF
}

enum JabatanType {
  WALI_KELAS
  ADMIN_KURIKULUM
  BENDAHARA
  PEMBINA_EKSKUL
  GURU_PIKET
  ADMIN_KESISWAAN
  KEPALA_SEKOLAH
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ScopeType {
  INSTITUSI
  KELAS
  EKSKUL
  SESI
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String         @map("password_hash")
  fullName        String         @map("full_name")
  phone           String?
  avatarUrl       String?        @map("avatar_url")
  userCategory    UserCategory   @default(SISWA) @map("user_category")
  status          AccountStatus  @default(ACTIVE)
  schoolId        String         @map("school_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments     UserAssignment[] @relation("UserAssignments")
  assignmentsGiven UserAssignment[] @relation("AssignedBy")
  teacherProfile  Teacher?
  studentProfile  Student?
  auditLogs       AuditLog[]
  recordedAttendances AttendanceRecord[] @relation("RecordedBy")
  reviewedLeaves   StudentLeaveRequest[] @relation("ReviewedLeaves")
  recordedPayments Payment[]             @relation("RecordedPayments")
  piketAssignments SubstituteTeacherLog[] @relation("PiketAssignments")
  promotionsDecided ClassPromotionHistory[] @relation("PromotionsDecided")

  @@index([schoolId])
  @@index([userCategory])
  @@map("users")
}

// Definisi Permission Granular
model Permission {
  id          String                 @id @default(uuid())
  name        String                 @unique // e.g. "MANAGE_FINANCE", "RECORD_ATTENDANCE", "VERIFY_LEAVES"
  category    String                 // e.g. "Keuangan", "Akademik", "Administrasi", "Kesiswaan"
  description String?
  assignments AssignmentPermission[]

  @@map("permissions")
}

// Relasi Many-to-Many antara Penugasan Jabatan dan Permission Eksplisit
model AssignmentPermission {
  id           String         @id @default(uuid())
  assignmentId String         @map("assignment_id")
  permissionId String         @map("permission_id")

  assignment   UserAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, permissionId])
  @@map("assignment_permissions")
}

// Penugasan & Jabatan Dinamis Berlingkup (Scoped Assignment)
model UserAssignment {
  id                String       @id @default(uuid())
  userId            String       @map("user_id")
  jabatan           JabatanType
  scopeType         ScopeType    @default(INSTITUSI) @map("scope_type")
  classroomId       String?      @map("classroom_id")
  academicYearId    String       @map("academic_year_id")
  extraCurricularId String?      @map("extracurricular_id")
  startDate         DateTime     @default(now()) @map("start_date")
  endDate           DateTime?    @map("end_date")
  isActive          Boolean      @default(true) @map("is_active")
  assignedByUserId  String?      @map("assigned_by_user_id")
  createdAt         DateTime     @default(now()) @map("created_at")

  user              User         @relation("UserAssignments", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy        User?        @relation("AssignedBy", fields: [assignedByUserId], references: [id])
  classroom         Classroom?   @relation(fields: [classroomId], references: [id])
  academicYear      AcademicYear @relation(fields: [academicYearId], references: [id])
  extraCurricular   Extracurricular? @relation(fields: [extraCurricularId], references: [id])
  permissions       AssignmentPermission[]

  @@index([userId, isActive])
  @@index([jabatan, academicYearId])
  @@map("user_assignments")
}

// ==========================================
// 2. STRUKTUR SEKOLAH & AKADEMIK
// ==========================================

model School {
  id              String       @id @default(uuid())
  npsn            String       @unique
  name            String
  educationLevel  String       @map("education_level") // SMP, MTs, SMA, MA, SMK
  address         String?
  city            String?
  province        String?
  phone           String?
  email           String?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  users           User[]
  classrooms      Classroom[]
  academicYears   AcademicYear[]
  extracurriculars Extracurricular[]

  @@map("schools")
}

model AcademicYear {
  id          String       @id @default(uuid())
  schoolId    String       @map("school_id")
  name        String       // Contoh: "2026/2027"
  semester    String       // "Ganjil" | "Genap"
  startDate   DateTime     @map("start_date")
  endDate     DateTime     @map("end_date")
  isCurrent   Boolean      @default(false) @map("is_current")
  createdAt   DateTime     @default(now()) @map("created_at")

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments UserAssignment[]
  classrooms  Classroom[]
  scheduleItems ScheduleItem[]

  @@index([schoolId, isCurrent])
  @@map("academic_years")
}

model Classroom {
  id             String       @id @default(uuid())
  schoolId       String       @map("school_id")
  academicYearId String       @map("academic_year_id")
  name           String       // Contoh: "X-A", "XII RPL 1"
  grade          Int          // 7, 8, 9, 10, 11, 12
  major          String?      // IPA, IPS, RPL, TKJ
  room           String?
  createdAt      DateTime     @default(now()) @map("created_at")

  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  students       Student[]
  assignments    UserAssignment[]
  journals       TeachingJournal[]
  attendances    AttendanceRecord[]
  scheduleItems  ScheduleItem[]
  substituteLogs SubstituteTeacherLog[]
  promotionsFrom ClassPromotionHistory[] @relation("PromotionFromClass")

  @@index([schoolId, academicYearId])
  @@map("classrooms")
}

model Extracurricular {
  id          String       @id @default(uuid())
  schoolId    String       @map("school_id")
  name        String       // Robotik, PMR, Paskibra, Futsal
  category    String       // Olahraga, Seni & Budaya, Sains & Teknologi, Kepemimpinan
  coachName   String?      @map("coach_name")
  schedule    String?
  room        String?
  createdAt   DateTime     @default(now()) @map("created_at")

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments UserAssignment[]

  @@map("extracurriculars")
}

// ==========================================
// 3. GURU & SISWA
// ==========================================

model Teacher {
  id              String       @id @default(uuid())
  userId          String       @unique @map("user_id")
  nip             String?      @unique
  nuptk           String?      @unique
  specialization  String?      // Contoh: "Matematika", "Fisika"
  joinDate        DateTime?    @map("join_date")

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  journals        TeachingJournal[]
  assessments     Assessment[]
  originalSubstituteLogs SubstituteTeacherLog[] @relation("OriginalTeacher")
  assignedSubstituteLogs SubstituteTeacherLog[] @relation("SubstituteTeacher")

  @@map("teachers")
}

model Student {
  id              String       @id @default(uuid())
  userId          String       @unique @map("user_id")
  classroomId     String       @map("classroom_id")
  nisn            String       @unique
  nis             String       @unique
  gender          String       // "L" | "P"
  birthPlace      String?      @map("birth_place")
  birthDate       DateTime?    @map("birth_date")
  parentName      String?      @map("parent_name")
  parentPhone     String?      @map("parent_phone")
  parentEmail     String?      @map("parent_email")
  address         String?
  createdAt       DateTime     @default(now()) @map("created_at")

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  classroom       Classroom    @relation(fields: [classroomId], references: [id])
  attendances     AttendanceRecord[]
  leaveRequests   StudentLeaveRequest[]
  invoices        Invoice[]
  scores          StudentScore[]
  promotionHistories ClassPromotionHistory[]

  @@index([classroomId])
  @@map("students")
}

// ==========================================
// 4. JADWAL, PRESENSI & JURNAL KELAS
// ==========================================

model ScheduleItem {
  id             String       @id @default(uuid())
  classroomId    String       @map("classroom_id")
  academicYearId String       @map("academic_year_id")
  day            String       // Senin, Selasa, Rabu, Kamis, Jumat, Sabtu
  timeSlot       String       @map("time_slot") // "07:30 - 09:00"
  subjectName    String       @map("subject_name")
  teacherName    String       @map("teacher_name")
  room           String?
  createdAt      DateTime     @default(now()) @map("created_at")

  classroom      Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([classroomId, day])
  @@map("schedule_items")
}

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  ALPA
}

model AttendanceRecord {
  id              String           @id @default(uuid())
  studentId       String           @map("student_id")
  classroomId     String           @map("classroom_id")
  date            DateTime         @db.Date
  status          AttendanceStatus @default(HADIR)
  note            String?
  recordedByUserId String          @map("recorded_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroom       Classroom        @relation(fields: [classroomId], references: [id])
  recordedBy      User             @relation("RecordedBy", fields: [recordedByUserId], references: [id])

  @@unique([studentId, date])
  @@index([classroomId, date])
  @@map("attendance_records")
}

model TeachingJournal {
  id              String       @id @default(uuid())
  teacherId       String       @map("teacher_id")
  classroomId     String       @map("classroom_id")
  subjectName     String       @map("subject_name")
  teachingDate    DateTime     @map("teaching_date")
  topic           String
  description     String?
  attendanceSummary String?    @map("attendance_summary")
  createdAt       DateTime     @default(now()) @map("created_at")

  teacher         Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classroom       Classroom    @relation(fields: [classroomId], references: [id])

  @@index([teacherId, teachingDate])
  @@map("teaching_journals")
}

model SubstituteTeacherLog {
  id                   String       @id @default(uuid())
  date                 DateTime     @db.Date
  timeSlot             String       @map("time_slot")
  classroomId          String       @map("classroom_id")
  originalTeacherId    String       @map("original_teacher_id")
  substituteTeacherId  String       @map("substitute_teacher_id")
  assignedByUserId     String       @map("assigned_by_user_id")
  reason               String?
  createdAt            DateTime     @default(now()) @map("created_at")

  classroom            Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  originalTeacher      Teacher      @relation("OriginalTeacher", fields: [originalTeacherId], references: [id])
  substituteTeacher    Teacher      @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id])
  assignedBy           User         @relation("PiketAssignments", fields: [assignedByUserId], references: [id])

  @@map("substitute_teacher_logs")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model StudentLeaveRequest {
  id              String       @id @default(uuid())
  studentId       String       @map("student_id")
  leaveType       String       @map("leave_type") // SAKIT, IZIN, DISPENSASI
  startDate       DateTime     @map("start_date")
  endDate         DateTime     @map("end_date")
  reason          String
  attachmentUrl   String?      @map("attachment_url")
  status          LeaveStatus  @default(PENDING)
  reviewedByUserId String?     @map("reviewed_by_user_id")
  reviewedAt      DateTime?    @map("reviewed_at")
  reviewNotes     String?      @map("review_notes")
  createdAt       DateTime     @default(now()) @map("created_at")

  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewedBy      User?        @relation("ReviewedLeaves", fields: [reviewedByUserId], references: [id])

  @@index([studentId, status])
  @@map("student_leave_requests")
}

// ==========================================
// 5. PENILAIAN & KENAIKAN KELAS
// ==========================================

enum AssessmentType {
  TUGAS
  UTS
  UAS
  PRAKTIKUM
}

model Assessment {
  id              String         @id @default(uuid())
  teacherId       String         @map("teacher_id")
  title           String         // Contoh: "Ulangan Harian 1 Matriks"
  assessmentType  AssessmentType @map("assessment_type")
  maxScore        Float          @default(100) @map("max_score")
  weight          Float          @default(1.0)
  createdAt       DateTime       @default(now()) @map("created_at")

  teacher         Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  scores          StudentScore[]

  @@map("assessments")
}

model StudentScore {
  id              String       @id @default(uuid())
  assessmentId    String       @map("assessment_id")
  studentId       String       @map("student_id")
  score           Float
  feedback        String?
  createdAt       DateTime     @default(now()) @map("created_at")

  assessment      Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@map("student_scores")
}

enum PromotionStatus {
  NAIK_KELAS
  TINGGAL_KELAS
  LULUS
}

model ClassPromotionHistory {
  id                 String          @id @default(uuid())
  studentId          String          @map("student_id")
  fromAcademicYearId String          @map("from_academic_year_id")
  toAcademicYearId   String          @map("to_academic_year_id")
  fromClassroomId    String          @map("from_classroom_id")
  toClassroomId      String?         @map("to_classroom_id")
  status             PromotionStatus @default(NAIK_KELAS)
  notes              String?
  decidedByUserId    String          @map("decided_by_user_id")
  createdAt          DateTime        @default(now()) @map("created_at")

  student            Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromClassroom      Classroom       @relation("PromotionFromClass", fields: [fromClassroomId], references: [id])
  decidedBy          User            @relation("PromotionsDecided", fields: [decidedByUserId], references: [id])

  @@index([studentId])
  @@map("class_promotion_histories")
}

// ==========================================
// 6. KEUANGAN & PEMBAYARAN MIDTRANS
// ==========================================

enum InvoiceStatus {
  UPCOMING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentChannel {
  MIDTRANS_SNAP
  CASH_TELLER
  BANK_TRANSFER
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNo       String        @unique @map("invoice_no")
  studentId       String        @map("student_id")
  title           String        // Contoh: "SPP Bulan November 2026"
  category        String        // SPP, Praktikum, Kegiatan, Gedung
  amount          Decimal       @db.Decimal(12, 2)
  amountPaid      Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  dueDate         DateTime      @map("due_date") @db.Date
  status          InvoiceStatus @default(UPCOMING)
  description     String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments        Payment[]

  @@index([studentId, status])
  @@index([dueDate])
  @@map("invoices")
}

model Payment {
  id              String         @id @default(uuid())
  invoiceId       String         @map("invoice_id")
  amount          Decimal        @db.Decimal(12, 2)
  paymentChannel  PaymentChannel @map("payment_channel")
  paymentMethod   String?        @map("payment_method") // gopay, qris, bca_va, bri_va, mandiri_va, cash
  midtransOrderId String?        @unique @map("midtrans_order_id")
  transactionId   String?        @map("transaction_id")
  transactionStatus String       @default("pending") @map("transaction_status") // settlement, pending, deny, expire, cancel
  settledAt       DateTime?      @map("settled_at")
  rawCallback     Json?          @map("raw_callback")
  recordedByUserId String?       @map("recorded_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy      User?          @relation("RecordedPayments", fields: [recordedByUserId], references: [id])

  @@index([invoiceId])
  @@index([midtransOrderId])
  @@map("payments")
}

// ==========================================
// 7. AUDIT LOG & KEAMANAN
// ==========================================

model AuditLog {
  id              String       @id @default(uuid())
  userId          String?      @map("user_id")
  action          String       // CREATE_INVOICE, CASH_PAYMENT, UPDATE_PERMISSION, etc.
  entity          String       // Invoice, UserAssignment, Student, etc.
  entityId        String?      @map("entity_id")
  details         Json?
  ipAddress       String?      @map("ip_address")
  userAgent       String?      @map("user_agent")
  createdAt       DateTime     @default(now()) @map("created_at")

  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_logs")
}
